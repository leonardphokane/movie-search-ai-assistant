# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/

# Local environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE/editor settings
.vscode/
.idea/
*.swp
*.swo

# OS-specific files
.DS_Store
Thumbs.db

# Logs
*.log

# Coverage reports
coverage/

# TypeScript build info
*.tsbuildinfo

# Misc cache
.cache/
.tmp/

# Lock files (optional, if you don’t want to commit them)
package-lock.json
yarn.lock
pnpm-lock.yaml

# GitHub Actions / CI
*.pid
*.seed
*.tgz

# Ignore generated images or assets if needed
# (but allow specific README screenshots)
public/*.png
public/*.jpeg
public/*.gif

# Exceptions: keep these tracked
!public/frontend.jpg
!public/javascript.jpg
!public/web-dev-1.jpg
